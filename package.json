{
  "name": "@en32/debuggy",
  "version": "2.3.1",
  "description": "A simple debug logger.",
  "main": "dist/debuggy.js",
  "module": "src/debuggy.ts",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/debuggy.js"
    },
    "./global": {
      "types": "./global/global.d.ts",
      "import": "./global/global.js"
    },
    "./utils": {
      "types": "./dist/types/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./buffered": {
      "types": "./dist/types/buffered.d.ts",
      "import": "./dist/buffered.js"
    }
  },
  "scripts": {
    "build": "bun build.ts",
    "build:watch": "bun run build.ts --watch",
    "build:tsc": "tsc",
    "ex:custom:js": "DEBUG=debuggy nodemon ./examples/js/custom.js",
    "ex:custom:ts": "DEBUG=debuggy bun run --hot ./examples/ts/custom.ts",
    "ex:simple:js": "DEBUG=debuggy nodemon ./examples/js/simple.js",
    "ex:simple:ts": "DEBUG=debuggy bun run --hot ./examples/ts/simple.ts",
    "ex:server:js": "DEBUG=debuggy nodemon ./examples/js/server/index.js",
    "ex:server:ts": "DEBUG=debuggy bun --hot ./examples/ts/server/index.ts",
    "ex:buffer:js": "nodemon ./examples/js/buffered.js",
    "ex:buffer:js:debug": "DEBUG=debuggy nodemon ./examples/js/buffered.js",
    "ex:buffer:ts": "DEBUG=debuggy bun run --hot ./examples/ts/buffered.ts",
    "ex:logger:js": "DEBUG=debuggy nodemon ./examples/js/logger.js",
    "ex:logger:ts": "bun run --hot ./examples/ts/logger.ts",
    "ex:logger:ts:debug": "DEBUG=debuggy bun run --hot ./examples/ts/logger.ts"
  },
  "files": [
    "dist",
    "src",
    "global",
    "package.json"
  ],
  "keywords": [
    "debug",
    "logger",
    "bun",
    "node"
  ],
  "author": "Enix Ardiansyah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/enix1032/debuggy.git"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "@en32/debuggy": "file:./../debuggy"
  },
  "dependencies": {
    "@en32/logger": "link:./../logger"
  },
  "dependenciesMeta": {
    "@en32/logger": {
      "optional": true
    }
  }
}
