{
  "name": "@en32/debuggy",
  "version": "2.0.5",
  "description": "A simple debug logger.",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./global": {
      "import": "./global.js"
    },
    "./utils": {
      "import": "./src/utils.ts"
    }
  },
  "scripts": {
    "build:node:min": "bun build ./src/index.ts --outfile=./dist/index.js --target=node --minify",
    "build:node:watch": "bun build ./src/index.ts --outfile=./dist/index.js --target=node --watch"
  },
  "files": [
    "dist",
    "src",
    "global.js",
    "global.ts",
    "package.json",
    "tsconfig.json"
  ],
  "keywords": [
    "debug",
    "logger",
    "bun",
    "node"
  ],
  "author": "Enix Ardiansyah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/enix1032/debuggy.git"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
